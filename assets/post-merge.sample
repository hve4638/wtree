#!/usr/bin/env sh
# Called after `wtree merge` and the merge half of `wtree land`
# A non-zero exit is a non-blocking warning
# New files a hook leaves stop `land`'s destroy half (`stopped:`)
#
# cwd = $WTREE_PATH
#
#   WTREE_HOOK         post-merge
#   WTREE_REPO         primary worktree root
#   WTREE_INTERACTIVE  1 when stdout is a terminal, else 0
#   WTREE_PATH         the worktree that was merged
#   WTREE_BRANCH       source branch
#   WTREE_TARGET       target branch
#   WTREE_MODE         squash | rebase | no-ff | ff
#   WTREE_MESSAGE      -m text; empty under --rebase and --ff
#   WTREE_VERB         merge | land
#   WTREE_DIRTY        1 when the tree has uncommitted changes, else 0
#   WTREE_TIP          target tip after the merge, abbreviated commit id
#
# To enable this hook, rename this file to "post-merge"

set -eu
